{
  "name": "vr-proje-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Firebase Cloud Functions: AI gateway for VR triage simulator (modul3Chat)",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions:modul3Chat",
    "test": "jest --colors",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "firebase-admin": "^12.4.0",
    "firebase-functions": "^5.0.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/node-fetch": "^2.6.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5"
  }
}
